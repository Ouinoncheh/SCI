# Configure these values in the hosting provider's private environment settings.
NODE_ENV=production
PORT=3000
BETTER_AUTH_URL=https://axelblaze.bid
DATABASE_URL=
BETTER_AUTH_SECRET=
MAIL_MODE=resend
RESEND_API_KEY=
SMTP_URL=
MAIL_FROM=
DESIGN_GENERATION_ENABLED=false
LISTING_ALLOWED_HOSTS=
CEREMA_DVF_URL=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
MEDIA_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=predictsci-private
RUN_MIGRATIONS_ON_START=true
LEBONCOIN_SERVICE_ENABLED=true
# Laisser vides pour utiliser le service Python inclus dans le conteneur Docker.
LEBONCOIN_SERVICE_URL=
LEBONCOIN_SERVICE_TOKEN=
# Connexion Google facultative (secrets privés Render).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

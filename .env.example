DATABASE_URL="postgresql://predict:local_development_only@localhost:5432/predictsci?schema=public"
# Public demo remains available independently of the private workspace.
APP_MODE="demo"
BETTER_AUTH_URL="http://127.0.0.1:3000"
# Generate a unique random secret of at least 32 characters; never commit the value.
BETTER_AUTH_SECRET=""
# In development only: verification/reset messages are saved privately under .local/mail.
MAIL_MODE="local"
# Configure SMTP and HTTPS before a production deployment.
SMTP_URL=""
RESEND_API_KEY=""
MAIL_FROM=""
# Domaines exacts disposant d’une autorisation d’import HTML (aucun par défaut).
# Ne pas ajouter un portail sans accord d’accès et droits de réutilisation.
LISTING_ALLOWED_HOSTS=""
# URL officielle DVF CEREMA vérifiée pour votre déploiement. Vide : DVF indisponible.
CEREMA_DVF_URL=""
# Génération d’images désactivée par défaut. Clé exclusivement côté serveur.
DESIGN_GENERATION_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL=""
# Local default retains files in PostgreSQL; production uses a private Supabase bucket.
MEDIA_STORAGE="database"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="predictsci-private"
# Service Python interne facultatif (aucune clé Leboncoin). Même token dans les deux processus.
LEBONCOIN_SERVICE_URL=""
LEBONCOIN_SERVICE_TOKEN=""
LEBONCOIN_SERVICE_ENABLED="false"
